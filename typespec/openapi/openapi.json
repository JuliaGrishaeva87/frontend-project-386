  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorBody"
          }
        }
      },
      "ApiErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Booking": {
        "type": "object",
        "required": [
          "id",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/BookingDraft"
          }
        ]
      },
      "BookingDraft": {
        "type": "object",
        "required": [
          "eventTypeId",
          "start",
          "guestName",
          "guestEmail"
        ],
        "properties": {
          "eventTypeId": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "guestName": {
            "type": "string"
          },
          "guestEmail": {
            "type": "string"
          }
        }
      },
      "EventType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "EventTypeDraft": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "service": {
            "type": "string"
          }
        }
      },
      "Slot": {
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TimeRange": {
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "string",
            "description": "Start of the range, HH:MM (UTC)."
          },
          "end": {
            "type": "string",
            "description": "End of the range, HH:MM (UTC)."
          }
        }
      },
      "WeeklyAvailability": {
        "type": "object",
        "properties": {
          "mon": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeRange"
            }
          },
          "tue": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeRange"
            }
          },
          "wed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeRange"
            }
          },
          "thu": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeRange"
            }
          },
          "fri": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeRange"
            }
          },
          "sat": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeRange"
            }
          },
          "sun": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeRange"
            }
          }
        }
      }
    }
