{
  "name": "@hexlet/code",
  "version": "1.1.0",
  "private": true,
  "description": "Call scheduling app (simplified Cal.com) — monorepo",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend & npm run dev --workspace frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pretest": "mkdir -p tmp/artifacts/test",
    "test": "vitest run --reporter=default --reporter=junit --outputFile.junit=tmp/artifacts/test/results.xml --reporter=json --outputFile.json=tmp/artifacts/test/results.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
